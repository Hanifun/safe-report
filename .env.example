# =====================================================
# SafeReport — Environment Variables
# =====================================================
# 1. Supabase (Wajib):
# Ambil dari: https://supabase.com/dashboard → Project Settings → API
# =====================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# =====================================================
# 2. Notifikasi Bot Telegram ke HP Admin (Opsional):
# 100% Gratis tanpa biaya, notifikasi instan langsung bunyi di HP Admin
# Buat bot via @BotFather dan dapatkan Chat ID via @userinfobot di Telegram
# Bisa diisi di sini ATAU langsung diatur melalui menu "Akun & Notifikasi" di Dashboard Admin.
# =====================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NEXT_PUBLIC_TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_CHAT_ID=
