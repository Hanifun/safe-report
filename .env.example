# =====================================================
# SafeReport — Environment Variables Template
#
# Petunjuk:
# Proyek ini sudah dilengkapi DUAL-ENGINE:
# - Secara default (tanpa env), aplikasi langsung berjalan menggunakan
#   penyimpanan lokal (localStorage) dengan data simulasi.
# - Jika ingin menghubungkan ke database cloud Supabase, buat file:
#   .env.local dan isi nilai di bawah ini dari dashboard https://supabase.com
# =====================================================

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
